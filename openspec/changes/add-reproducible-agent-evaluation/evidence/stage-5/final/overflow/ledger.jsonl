{"data": {"auxiliary_agents": false, "compression": false, "context_window": 200000, "facts_sha256": "82fdd3f32d9d59a7d66c9bfb00c8996bef7fcb1bae2210dd523195a7dfca5338", "limits": {"cleanup_seconds": 15, "provider_calls": 12, "seconds": 240, "single_request_tokens": 900000, "tokens": 1400000, "tool_calls": 12}, "output_limit": 4096, "tools": [{"description": "读取指定路径的文件内容，返回带行号的文本。文件不存在或不可读时返回结构化错误。", "input_schema": {"properties": {"path": {"type": "string"}}, "required": ["path"], "type": "object"}, "name": "read_file"}, {"description": "将内容写入指定路径的文件（覆盖写）。父目录不存在时自动创建。返回成功或结构化错误。", "input_schema": {"properties": {"content": {"description": "要写入的文件内容", "type": "string"}, "path": {"description": "要写入的文件路径", "type": "string"}}, "required": ["path", "content"], "type": "object"}, "name": "write_file"}, {"description": "对文件中的唯一匹配文本做精确替换。old_string 必须在文件中恰好出现一次，否则返回可区分错误。编辑前请先用 read_file 读取目标文件，确认 old_string 唯一。", "input_schema": {"properties": {"new_string": {"description": "替换后的新文本片段", "type": "string"}, "old_string": {"description": "文件中待替换的原文片段（需唯一匹配）", "type": "string"}, "path": {"description": "要编辑的文件路径", "type": "string"}}, "required": ["path", "old_string", "new_string"], "type": "object"}, "name": "edit_file"}, {"description": "在当前工作目录下执行 shell 命令，返回 stdout、stderr 和退出码。命令受超时约束（30s）。Windows 下使用 cmd /C，Linux/Mac 下使用 /bin/sh -c。读文件、找文件、搜内容请优先用 read_file/glob/grep，不要用 bash 拼凑。", "input_schema": {"properties": {"command": {"description": "要执行的 shell 命令", "type": "string"}}, "required": ["command"], "type": "object"}, "name": "bash"}, {"description": "按 glob 模式查找匹配的文件（不包含目录）。非递归：`*.py` 只匹配根目录下的 .py 文件。递归：`**/*.py` 匹配所有子目录中的 .py 文件。返回排序后的相对路径列表，最多 100 条。", "input_schema": {"properties": {"path": {"type": "string"}, "pattern": {"type": "string"}}, "required": ["pattern"], "type": "object"}, "name": "glob"}, {"description": "在文件内容中按正则表达式搜索，返回匹配位置（文件名:行号:内容）。最多返回 100 条命中。", "input_schema": {"properties": {"glob": {"type": "string"}, "path": {"type": "string"}, "pattern": {"type": "string"}}, "required": ["pattern"], "type": "object"}, "name": "grep"}, {"description": "按名称加载可用 Skill，并把完整 SOP 激活到后续迭代的环境上下文。", "input_schema": {"additionalProperties": false, "properties": {"name": {"type": "string"}}, "required": ["name"], "type": "object"}, "name": "LoadSkill"}, {"description": "从 skills.sh 或 GitHub URL 安装 Skill 到用户目录。", "input_schema": {"additionalProperties": false, "properties": {"url": {"type": "string"}}, "required": ["url"], "type": "object"}, "name": "InstallSkill"}]}, "kind": "ready", "monotonic": 29940.639471103, "run_id": "overflow", "schema_version": 1, "sequence": 1, "sha256": "f77d23f87054ee127d8533c4027c0be1769874b1aa46ef1633b4ff3a42ee0f56", "utc": "2026-10-09T12:42:12.557828+00:00"}
