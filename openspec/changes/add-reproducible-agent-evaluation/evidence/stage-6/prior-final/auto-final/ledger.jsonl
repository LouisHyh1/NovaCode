{"data": {"allowed_tools": ["read_file", "write_file", "edit_file", "bash", "glob", "grep", "ci_build_status", "mcp__fixed_ci__ci_build_failure"], "auxiliary_agents": false, "context_compression": true, "hooks": "frozen-empty", "instructions": "", "memory": "empty", "mode": "default", "permissions": {"allow": [], "deny": []}, "progressive_tool_schema": true, "registered_tools": [{"description": "读取指定路径的文件内容，返回带行号的文本。文件不存在或不可读时返回结构化错误。", "input_schema": {"properties": {"path": {"type": "string"}}, "required": ["path"], "type": "object"}, "name": "read_file"}, {"description": "将内容写入指定路径的文件（覆盖写）。父目录不存在时自动创建。返回成功或结构化错误。", "input_schema": {"properties": {"content": {"description": "要写入的文件内容", "type": "string"}, "path": {"description": "要写入的文件路径", "type": "string"}}, "required": ["path", "content"], "type": "object"}, "name": "write_file"}, {"description": "对文件中的唯一匹配文本做精确替换。old_string 必须在文件中恰好出现一次，否则返回可区分错误。编辑前请先用 read_file 读取目标文件，确认 old_string 唯一。", "input_schema": {"properties": {"new_string": {"description": "替换后的新文本片段", "type": "string"}, "old_string": {"description": "文件中待替换的原文片段（需唯一匹配）", "type": "string"}, "path": {"description": "要编辑的文件路径", "type": "string"}}, "required": ["path", "old_string", "new_string"], "type": "object"}, "name": "edit_file"}, {"description": "在当前工作目录下执行 shell 命令，返回 stdout、stderr 和退出码。命令受超时约束（30s）。Windows 下使用 cmd /C，Linux/Mac 下使用 /bin/sh -c。读文件、找文件、搜内容请优先用 read_file/glob/grep，不要用 bash 拼凑。", "input_schema": {"properties": {"command": {"description": "要执行的 shell 命令", "type": "string"}}, "required": ["command"], "type": "object"}, "name": "bash"}, {"description": "按 glob 模式查找匹配的文件（不包含目录）。非递归：`*.py` 只匹配根目录下的 .py 文件。递归：`**/*.py` 匹配所有子目录中的 .py 文件。返回排序后的相对路径列表，最多 100 条。", "input_schema": {"properties": {"path": {"type": "string"}, "pattern": {"type": "string"}}, "required": ["pattern"], "type": "object"}, "name": "glob"}, {"description": "在文件内容中按正则表达式搜索，返回匹配位置（文件名:行号:内容）。最多返回 100 条命中。", "input_schema": {"properties": {"glob": {"type": "string"}, "path": {"type": "string"}, "pattern": {"type": "string"}}, "required": ["pattern"], "type": "object"}, "name": "grep"}, {"description": "查询固定 CI 构建记录的状态，按 build_id 精确查询。", "input_schema": {"additionalProperties": false, "properties": {"build_id": {"type": "string"}}, "required": ["build_id"], "type": "object"}, "name": "ci_build_status"}, {"description": "查询固定 CI 构建记录的具体失败原因与是否允许重试，按 build_id 查询。", "input_schema": {"additionalProperties": false, "properties": {"build_id": {"type": "string"}}, "required": ["build_id"], "type": "object"}, "name": "mcp__fixed_ci__ci_build_failure"}], "session_id": "20261010-104108-284e", "strategy": "compression-on-schema-progressive", "version": "0.1.31"}, "kind": "initial_state", "monotonic": 1065.695422254, "run_id": "auto-final", "schema_version": 1, "sequence": 2, "sha256": "ac800682a0ed0550c8fe3d2c9d992fa405292631d91e1c4559e1089c046e18c3", "utc": "2026-10-10T02:41:08.787709+00:00"}
